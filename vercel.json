{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node src/build.mjs",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|svg|webp|jpg|jpeg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/site.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.googletagmanager.com 'sha256-bPKmkLwr/DEseXxvunjaG4t7K66jYmaoG5x5ftQQ764=' 'sha256-LjrC1AVG0KskKSfjCUUMQNWpT+FWDHDpipwwrq9JbRQ=' 'sha256-LmNDjpzPKunbczFP7TM0YVle1dTIYalHkQUjnc6fSP4='; style-src 'self' 'unsafe-inline'; img-src 'self' https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://us-central1-evenus-be315.cloudfunctions.net https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/join/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/join/:code([A-Za-z0-9-]{1,32})/",
      "destination": "/join/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(.*)/index.html",
      "destination": "/$1/",
      "permanent": true
    },
    {
      "source": "/blog/the-architecture-of-domestic-peace/",
      "destination": "/blog/from-conflict-to-collaboration-equity-at-home/",
      "permanent": true
    },
    {
      "source": "/blog/the-architecture-of-domestic-peace-in-modern-household/",
      "destination": "/blog/from-conflict-to-collaboration-equity-at-home/",
      "permanent": true
    },
    {
      "source": "/blog/the-efficiency-of-intimacy-reclaiming/",
      "destination": "/blog/from-conflict-to-collaboration-equity-at-home/",
      "permanent": true
    },
    {
      "source": "/blog/best-tools-to-track-and-share-domestic-responsibilities-fairly/",
      "destination": "/blog/best-chore-tracking-apps/",
      "permanent": true
    },
    {
      "source": "/feed/",
      "destination": "/feed.xml",
      "permanent": true
    },
    {
      "source": "/blog/feed/",
      "destination": "/feed.xml",
      "permanent": true
    },
    {
      "source": "/comments/feed/",
      "destination": "/feed.xml",
      "permanent": true
    },
    {
      "source": "/author/(.*)",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/category/(.*)",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/tag/(.*)",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog/page/(.*)",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/page/(.*)",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/(\\d{4})/(.*)",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/wp-admin/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/emotional-labor-in-marriage/",
      "destination": "/blog/emotional-labor-in-relationships/",
      "permanent": true
    }
  ]
}
